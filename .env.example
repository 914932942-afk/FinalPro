# 复制为 .env 后按需修改。API Key 只放在本机环境或密钥管理器，不要提交 Git。
AGENT_DATA_DIR=data
AGENT_DB_PATH=data/agent.db
AGENT_KB_DIR=data/knowledge
AGENT_CHROMA_DIR=data/chroma
AGENT_HOST=127.0.0.1
AGENT_PORT=8080

AGENT_LLM_MODE=offline
AGENT_LLM_STRICT=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_TEMPERATURE=0.1

AGENT_RAG_BACKEND=chroma
# 以上 RAG_BACKEND 与下面 RAG_HYBRID 控制历史规划/离线检索实验；当前排障使用 RUNBOOK_STRATEGY。
# true：真实向量 + BM25/RRF，按资源与错误码收紧范围；lexical 模式使用 BM25。
# false：纯向量；lexical 模式回到原始字符重合检索，供对照使用。
AGENT_RAG_HYBRID=true
# 本地权重已下载时可写绝对路径；留空会自动发现 data/models/bge-small-zh-v1.5
AGENT_EMBEDDING_MODEL=
AGENT_RAG_CHUNK_SIZE=500
AGENT_RAG_OVERLAP=80
AGENT_RAG_TOP_K=3
AGENT_RAG_BATCH_SIZE=64
# RAG 后处理：没有本地 reranker 权重时 optional 会安全保留融合结果并记录降级。
AGENT_RAG_SEMANTIC_DEDUP=true
AGENT_RAG_SEMANTIC_DEDUP_THRESHOLD=0.94
AGENT_RAG_RERANK_MODE=optional
# 可选：运行 scripts/download_reranker.py 后会自动发现 data/models/bge-reranker-base
AGENT_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
AGENT_RAG_RERANK_CANDIDATE_K=12
AGENT_RAG_RERANK_MIN_SCORE=-100

AGENT_LLM_FAILURE_THRESHOLD=3
AGENT_LLM_RECOVERY_TIMEOUT=30
AGENT_RAG_FAILURE_THRESHOLD=3
AGENT_RAG_RECOVERY_TIMEOUT=30
AGENT_TOOL_FAILURE_THRESHOLD=3
AGENT_TOOL_RECOVERY_TIMEOUT=30
AGENT_SQLITE_TIMEOUT=5
AGENT_OPERATION_RETRY_AFTER=3
AGENT_CLARIFICATION_MAX_ROUNDS=3
# 模型自报分数仅作为保守拦截条件，不代表经过校准的正确率。
AGENT_DECISION_MIN_CONFIDENCE=0.8
# 默认给规划器提供 SOP；false 仅用于不检索的对照实验。
AGENT_PLANNING_USE_SOP=true
# true 时离线规则的明确敏感请求也要求本人确认；模型敏感计划始终要求确认。
AGENT_REQUIRE_ACTION_CONFIRMATION=false
AGENT_APPROVAL_TTL_HOURS=24
AGENT_SUBMISSION_COMPLETED_WINDOW_SECONDS=600
# 默认在 AGENT_DATA_DIR/auth.json 读取身份；运行 python -m app.auth init 初始化。
# AGENT_AUTH_FILE=data/auth.json
# AGENT_ACCOUNT_BINDINGS_FILE=data/account_bindings.json
# VPN / ERP 故障登记后的只读调查：off / react / fixed / rule。
# 本地遥测为模拟数据；文件缺失时跳过，不阻断原工单登记。
# 新版原始日志调查由模型关联会话和检索规程；旧结构化诊断保留用于历史对照。
AGENT_DIAGNOSIS_MODE=react
AGENT_DIAGNOSIS_BACKEND=investigation
# file keeps the local replay fixture; http uses an independent read-only telemetry adapter.
AGENT_INVESTIGATION_SOURCE=file
AGENT_TELEMETRY_BASE_URL=http://127.0.0.1:8092
AGENT_TELEMETRY_API_KEY=
AGENT_TELEMETRY_TIMEOUT=5
# HTTP investigation requires a bounded incident time before reading telemetry.
AGENT_DIAGNOSIS_REQUIRE_TIME=true
AGENT_DIAGNOSIS_TIMEZONE=+08:00
AGENT_DIAGNOSIS_WINDOW_BEFORE_MINUTES=15
AGENT_DIAGNOSIS_WINDOW_AFTER_MINUTES=15
# AGENT_INVESTIGATION_FILE=data/diagnostics/it_events.json
# AGENT_RUNBOOKS_FILE=data/diagnostics/runbooks.json
# RUNBOOKS_FILE 仅保留历史实验；当前生产路径使用版本化 Markdown。
# AGENT_RUNBOOKS_DIR=data/knowledge/runbooks
# bm25 / vector / hybrid：纯词项、纯向量、BM25+BGE/RRF；后两者真实加载本地 BGE。
# 当前默认 vector：先过滤未证实部署的规程，BGE 查询使用检索指令；故障时显式降级 BM25。
# 混合检索保留对照，不强制融合。冷启动仍约 14 秒，CPU 模型约需 0.5 GiB 内存。
AGENT_RUNBOOK_STRATEGY=hybrid
AGENT_DIAGNOSIS_PREFETCH=true
AGENT_DIAGNOSIS_BACKGROUND=true
# 同一事件最多调查 3 轮、自动追问 2 次；补充信息不会重新登记事件。
AGENT_DIAGNOSIS_MAX_ATTEMPTS=3
AGENT_DIAGNOSIS_MAX_QUESTIONS=2
# 独立巡检的排队/运行时限；每轮调查最多运行 3 次（首次 + 2 次人工重试）。
AGENT_DIAGNOSIS_WORKER_TIMEOUT=90
AGENT_DIAGNOSIS_QUEUE_TIMEOUT=120
AGENT_DIAGNOSIS_WORKER_MAX_RUNS=3
AGENT_DIAGNOSIS_WORKER_POLL=5
AGENT_DIAGNOSIS_WORKERS=2
# 用户回复、验证与原单重开的业务期限；提醒仅记录到站内服务动态。
AGENT_CASE_USER_REPLY_HOURS=48
AGENT_CASE_USER_REMINDER_HOURS=24
AGENT_CASE_VERIFICATION_HOURS=72
AGENT_CASE_VERIFICATION_REMINDER_HOURS=24
AGENT_CASE_REOPEN_DAYS=7
AGENT_DIAGNOSIS_DEADLINE=60
# python -m app.workbench starts both services and injects a separate generated service key.
# Direct API mode remains simulated unless explicitly configured below.
AGENT_ACTION_BACKEND=simulated
AGENT_ACTION_BASE_URL=http://127.0.0.1:8091
AGENT_ACTION_API_KEY=
AGENT_ACTION_TIMEOUT=5
# AGENT_DIAGNOSIS_FILE=data/diagnostics/vpn.json
