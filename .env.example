# Copy to .env. Keep API keys outside version control.
AGENT_DATA_DIR=data
AGENT_DB_PATH=data/agent.db
AGENT_KB_DIR=data/knowledge
AGENT_CHROMA_DIR=data/chroma
AGENT_HOST=127.0.0.1
AGENT_PORT=8080

# offline is reproducible and needs no network. Use deepseek/auto only with a key.
AGENT_LLM_MODE=offline
AGENT_LLM_STRICT=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_TEMPERATURE=0.1

# RAG and local model settings
AGENT_RAG_BACKEND=chroma
AGENT_RAG_HYBRID=true
AGENT_EMBEDDING_MODEL=
AGENT_RUNBOOK_STRATEGY=hybrid
AGENT_RAG_SEMANTIC_DEDUP=true
AGENT_RAG_SEMANTIC_DEDUP_THRESHOLD=0.94
AGENT_RAG_RERANK_MODE=optional
AGENT_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
AGENT_RAG_RERANK_CANDIDATE_K=12
AGENT_RAG_RERANK_MIN_SCORE=-100

# Agent guardrails
AGENT_CLARIFICATION_MAX_ROUNDS=3
AGENT_DECISION_MIN_CONFIDENCE=0.8
AGENT_PLANNING_USE_SOP=true
AGENT_REQUIRE_ACTION_CONFIRMATION=false
AGENT_DIAGNOSIS_MODE=react
AGENT_DIAGNOSIS_BACKEND=investigation
AGENT_DIAGNOSIS_PREFETCH=true
AGENT_DIAGNOSIS_BACKGROUND=true
# Per incident: at most 3 investigation attempts and 2 automatic user questions.
AGENT_DIAGNOSIS_MAX_ATTEMPTS=3
AGENT_DIAGNOSIS_MAX_QUESTIONS=2
# Independent watchdog and bounded workers; 3 runs = initial run + 2 staff retries.
AGENT_DIAGNOSIS_WORKER_TIMEOUT=90
AGENT_DIAGNOSIS_QUEUE_TIMEOUT=120
AGENT_DIAGNOSIS_WORKER_MAX_RUNS=3
AGENT_DIAGNOSIS_WORKER_POLL=5
AGENT_DIAGNOSIS_WORKERS=2
AGENT_DIAGNOSIS_DEADLINE=60

# Reliability and simulated HTTP downstream
AGENT_LLM_FAILURE_THRESHOLD=3
AGENT_LLM_RECOVERY_TIMEOUT=30
AGENT_RAG_FAILURE_THRESHOLD=3
AGENT_RAG_RECOVERY_TIMEOUT=30
AGENT_TOOL_FAILURE_THRESHOLD=3
AGENT_TOOL_RECOVERY_TIMEOUT=30
AGENT_SQLITE_TIMEOUT=5
AGENT_OPERATION_RETRY_AFTER=3
AGENT_ACTION_BACKEND=simulated
AGENT_ACTION_BASE_URL=http://127.0.0.1:8091
AGENT_ACTION_API_KEY=
AGENT_ACTION_TIMEOUT=5
